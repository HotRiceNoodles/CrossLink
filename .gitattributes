# Normalize line endings: LF in the repo, LF checked out on all platforms.
# This makes builds and diffs consistent regardless of local core.autocrlf.

* text=auto eol=lf

# Go, SQL, config, and docs are always text
*.go     text eol=lf
*.sql    text eol=lf
*.md     text eol=lf
*.yaml   text eol=lf
*.yml    text eol=lf
*.json   text eol=lf
*.mod    text eol=lf
*.sum    text eol=lf
*.conf   text eol=lf
Makefile text eol=lf
Dockerfile text eol=lf

# Windows-only scripts keep CRLF
*.bat    text eol=crlf
*.cmd    text eol=crlf
*.ps1    text eol=crlf

# Binaries — never normalize
*.png    binary
*.jpg    binary
*.jpeg   binary
*.gif    binary
*.ico    binary
*.woff   binary
*.woff2  binary
